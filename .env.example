SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Не используются сейчас нигде в коде, но settings.py их читает — можно оставить пустыми
VK_TOKEN=

# Устаревший вход через VK (social_django) — сейчас не используется,
# вместо него работает myapp/vk_id_auth.py (VK ID). Можно оставить пустыми.
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# SECURE_SSL_REDIRECT / SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE больше
# не читаются из .env — с 30.08.2026 они включаются автоматически, когда
# DEBUG=False (см. settings.py). Эти строки можно удалить, ничего не сломается.
CSRF_TRUSTED_ORIGINS=

CORS_ALLOWED_ORIGINS=

# ===== 2FA для /admin/ и /crm/ (config/settings.py, 01.09.2026) =====
# По умолчанию выключено. Порядок включения — см. комментарий у REQUIRE_2FA
# в settings.py: сперва привязать устройство на /2fa/setup/ и убедиться, что
# оно подтверждено, и только потом ставить True здесь. Если после включения
# что-то пошло не так — вернуть False и перезапустить observatory, доступ
# вернётся сразу же, без обращения к базе данных.
REQUIRE_2FA=False

# ===== Почта (config/settings.py) =====
# Если EMAIL_HOST оставить пустым — письма просто печатаются в консоль/лог
# (безопасно по умолчанию, ничего никуда не отправляет). Чтобы включить
# настоящую отправку через SMTP — заполнить эти переменные.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# ===== ИИ-разбор постов при массовой загрузке (config/settings.py, 01.09.2026) =====
# Полностью опционально. Без ключа массовая загрузка (/crm/posts/bulk/)
# работает как раньше — по дням недели или по строке ---. С ключом:
# если текст не подходит ни под один из этих форматов, сайт сам просит
# ИИ (Anthropic Claude) разложить его на отдельные посты, вместо того
# чтобы добавить весь текст одним постом. Ключ — с console.anthropic.com,
# платится по использованию (копейки за такой объём текста).
ANTHROPIC_API_KEY=
# Модель для разбора — по умолчанию быстрая и дешёвая. Актуальный список
# моделей: docs.claude.com/en/docs/about-claude/models
AI_SPLIT_MODEL=claude-haiku-4-5

# ===== Публикация постов по внешнему будильнику, без cron на сервере (01.09.2026) =====
# Полностью опционально — альтернатива системному cron для publish_due_posts,
# для тех, кому неудобно заходить в консоль сервера. Без значения — вебхук
# /crm/cron/publish-due/<секрет>/ всегда отвечает 404, ничем не рискует.
# Чтобы включить: придумать длинную случайную строку (например, командой
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`) и вписать
# сюда, а затем настроить бесплатный сервис-будильник (например cron-job.org)
# заходить каждые несколько минут на:
#   https://putnabludatel.ru/crm/cron/publish-due/<та же строка>/
PUBLISH_CRON_SECRET=

# ===== Настройки для VK-бота (vk_bot/config.py) =====
# Токен группы VK (для отправки сообщений ботом)
VK_GROUP_TOKEN=
# ID группы VK, в которой работает бот
VK_GROUP_ID=
# Адрес Django API, к которому обращается бот
API_BASE_URL=http://127.0.0.1:8000/api
# Токен для авторизации бота в Django API (DRF Token). С 01.09.2026 —
# отдельный сервис-аккаунт vk_bot_service, не admin (см. СВОДКА_ПРОЕКТА.md).
API_TOKEN=
# VK ID администраторов (психологов) через запятую
ADMIN_IDS=

# ===== Настройки для Telegram-бота (vk_bot/main_telegram.py) =====
# Токен бота из @BotFather (/newbot). Нужен только если запускаете
# main_telegram.py — на VK-бота (main.py) не влияет.
TELEGRAM_BOT_TOKEN=
# Публичный @username бота без "@" (например PutNablyudatelya_bot) — НЕ
# секрет, его видит любой, кто напишет боту. Нужен ОБОИМ ботам (и VK, и
# Telegram): используется, чтобы построить диплинк t.me/<username>?start=...
# для автоматической привязки аккаунтов (03.09.2026, см. СВОДКА_ПРОЕКТА.md).
# Без этой переменной привязка по-прежнему работает вручную (код текстом),
# просто без диплинка из VK в Telegram.
TELEGRAM_BOT_USERNAME=