SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Не используются сейчас нигде в коде, но settings.py их читает — можно оставить пустыми
VK_TOKEN=

# Устаревший вход через VK (social_django) — сейчас не используется,
# вместо него работает myapp/vk_id_auth.py (VK ID). Можно оставить пустыми.
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# SECURE_SSL_REDIRECT / SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE больше
# не читаются из .env — с 30.08.2026 они включаются автоматически, когда
# DEBUG=False (см. settings.py). Эти строки можно удалить, ничего не сломается.
CSRF_TRUSTED_ORIGINS=

CORS_ALLOWED_ORIGINS=

# ===== 2FA для /admin/ и /crm/ (config/settings.py, 01.09.2026) =====
# По умолчанию выключено. Порядок включения — см. комментарий у REQUIRE_2FA
# в settings.py: сперва привязать устройство на /2fa/setup/ и убедиться, что
# оно подтверждено, и только потом ставить True здесь. Если после включения
# что-то пошло не так — вернуть False и перезапустить observatory, доступ
# вернётся сразу же, без обращения к базе данных.
REQUIRE_2FA=False

# ===== Почта (config/settings.py) =====
# Если EMAIL_HOST оставить пустым — письма просто печатаются в консоль/лог
# (безопасно по умолчанию, ничего никуда не отправляет). Чтобы включить
# настоящую отправку через SMTP — заполнить эти переменные.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# ===== Настройки для VK-бота (vk_bot/config.py) =====
# Токен группы VK (для отправки сообщений ботом)
VK_GROUP_TOKEN=
# ID группы VK, в которой работает бот
VK_GROUP_ID=
# Адрес Django API, к которому обращается бот
API_BASE_URL=http://127.0.0.1:8000/api
# Токен для авторизации бота в Django API (DRF Token). С 01.09.2026 —
# отдельный сервис-аккаунт vk_bot_service, не admin (см. СВОДКА_ПРОЕКТА.md).
API_TOKEN=
# VK ID администраторов (психологов) через запятую
ADMIN_IDS=